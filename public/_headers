# Third-party origins are listed by exact hostname, never as a wildcard and
# never via 'unsafe-inline'. GTM can inject a tag without a deploy, but CSP
# cannot: 'strict-dynamic' would only cover script-src, and a tag's data
# connections (connect-src) and images (img-src) always need naming here.
#
# Two inline-script hashes, no 'unsafe-inline': the GTM loader, and the one
# line in index.html that sets window.titlaniaWidgetId. Both are byte-exact
# — editing either script without updating its hash here breaks it silently.
#
# Titlania (the support widget, loaded by a GTM Custom HTML tag):
#   script-src   widget.titlania.com   the bundle itself
#   connect-src  cdn.titlania.com      published bot document, fetched on open
#   connect-src  api.titlania.com      conversations, + wss for the live socket
#   img-src      cdn.titlania.com      author-set avatar and launcher icon
#   img-src      lh3.googleusercontent.com   agent's Google photo in live chat
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-ZfcJ+gN5TRGxf+dyZocUEbwyJ3Gc/2uplfIkyzWFmdg=' 'sha256-0g7AEWGWcMTQeAFAD3wMtiD9ik8Ra8ldhcig2Cm5Lgw=' https://static.cloudflareinsights.com https://www.googletagmanager.com https://widget.titlania.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.g.doubleclick.net https://cdn.titlania.com https://lh3.googleusercontent.com; connect-src 'self' https://cloudflareinsights.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.g.doubleclick.net https://cdn.titlania.com https://api.titlania.com wss://api.titlania.com; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

# Content-hashed filenames, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed and replaced in place, so paths are listed explicitly rather than by
# extension: a day in the browser, a week at the edge, stale copy served while
# revalidating. Add a line here when adding an image.
/armemon.webp
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
/withinbench-preview.webp
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
/titlania-preview.webp
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
/og-card.png
  Cache-Control: public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400
/icon-192.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800

# HTML and the crawler files must always revalidate, or a deploy takes days to
# reach anyone who has already visited.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
/llms.txt
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
